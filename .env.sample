# Gemini API Configuration
# Get your API key from: https://ai.google.dev/gemini-api/docs/api-key
# 
# For local development:
#   1. Copy this file to .env
#   2. Replace the placeholder with your actual API key
#
# For Vercel deployment:
#   1. Go to your Vercel project settings
#   2. Navigate to Settings > Environment Variables
#   3. Add VITE_GEMINI_API_KEY with your API key value
#
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Invite flow (/invite) — Firebase + Resend configuration contract
#
# Sprint 1 does not read any of these; they are documented ahead of the
# Sprint 2 (Firestore) and Sprint 3 (Resend) wiring described in
# specs/004-invite-sprint-1/spec.md. Set real values only in Vercel project
# settings (or a local .env, never committed) — never hardcode secrets here.
# ---------------------------------------------------------------------------

# Firebase Web SDK config (client-safe values, Sprint 2). Get these from
# Firebase console > Project settings > General > Your apps > SDK setup and
# configuration. Firestore security (firestore.rules), not secrecy of these
# values, is what protects the data — see specs/005-invite-sprint-2-firebase.md.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Resend email notifications — server-side only, read by api/send-invite-email.ts.
# (never prefix with VITE_: this must not be exposed to the client bundle)
# Setup (manual, do not automate DNS changes):
#   1. Create a Resend account: https://resend.com
#   2. Add a sending domain (e.g. mail.hugoviegas.dev) under Resend > Domains
#   3. Add the SPF + DKIM DNS records Resend gives you at your domain registrar
#   4. Wait for Resend to show the domain as "Verified"
#   5. Create an API key under Resend > API Keys, paste it below
RESEND_API_KEY=your_resend_api_key_here
# Where the "new invite" notification is sent.
INVITE_NOTIFY_EMAIL=hugo@example.com
# Must be on the verified domain from step 2-4 above (e.g. invite@mail.hugoviegas.dev).
INVITE_FROM_EMAIL=invite@hugoviegas.dev

# Firebase Admin SDK — server-side only, read by api/_lib/firebaseAdmin.ts.
# Get these from Firebase console > Project settings > Service accounts >
# Generate new private key (downloads a JSON file with these three fields).
# FIREBASE_ADMIN_PRIVATE_KEY must keep its literal "\n" sequences when pasted
# into a single-line env var — the code un-escapes them at runtime.
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
